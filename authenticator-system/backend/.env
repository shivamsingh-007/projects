# ============================================
# OTP AUTHENTICATOR - ENVIRONMENT VARIABLES
# ============================================

# Application Settings
NODE_ENV=development
PORT=5000
APP_NAME=OTP Authenticator

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Database Configuration
# For MongoDB Atlas, format: mongodb+srv://username:password@cluster.mongodb.net/database
# For local MongoDB: mongodb://localhost:27017/otp-authenticator
MONGODB_URI=mongodb://localhost:27017/otp-authenticator

# JWT Secret (Generate a strong random string)
# You can generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here_change_this

# Email Configuration (Gmail)
# IMPORTANT: For Gmail, you MUST use an "App Password", not your regular password
# Steps to get App Password:
# 1. Go to Google Account Settings
# 2. Security > 2-Step Verification (enable if not already)
# 3. App passwords > Select app: Mail > Select device: Other > Generate
# 4. Copy the 16-character password and paste below
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password

# Twilio Configuration (SMS)
# Sign up at: https://www.twilio.com/try-twilio
# Get your credentials from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================
# SETUP INSTRUCTIONS
# ============================================

# 1. MONGODB SETUP:
#    - Local: Install MongoDB and start service
#    - Cloud: Create free cluster at mongodb.com/cloud/atlas
#    - Copy connection string and replace MONGODB_URI above

# 2. EMAIL SETUP (GMAIL):
#    - Use Gmail account
#    - Enable 2-Factor Authentication
#    - Generate App Password (see steps above)
#    - Replace EMAIL_USER and EMAIL_PASSWORD

# 3. TWILIO SETUP (SMS):
#    - Sign up at twilio.com
#    - Verify your phone number
#    - Get free trial credits ($15)
#    - Copy Account SID, Auth Token, and Phone Number
#    - Replace TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_PHONE_NUMBER
#    - Note: Trial accounts can only send to verified numbers

# 4. JWT SECRET:
#    - Generate a random string (32+ characters)
#    - Never share this secret
#    - Change it in production

# ============================================
# PRODUCTION NOTES
# ============================================

# - Change NODE_ENV to 'production'
# - Use strong JWT_SECRET (64+ characters)
# - Use environment variables in hosting platform
# - Never commit .env file to version control
# - Use MongoDB Atlas for cloud database
# - Consider upgrading Twilio account for production
